---
// registry:block — composed page section, installs to components/blocks
import type { HTMLAttributes } from "astro/types";
import { clx, uniqueId } from "@/lib/ftds/utils";
import Button from "@/components/ui/button.astro";
import Tag from "@/components/ui/tag.astro";

import {
  actions_cva,
  band_cva,
  container_cva,
  content_cva,
  media_cva,
  secondary_action_cva,
} from "@mof-malaysia/ftds-style/variants/hero";
/**
 * Hero is the opening section of an agency or landing page: an optional
 * eyebrow tag, the page's single h1, supporting text, a primary and a
 * secondary action, and optional media.
 *
 * Layouts: `stacked` (text only; the default without media), `split` (text
 * beside the media on desktop; the default with media, `mediaPosition` picks
 * the side) and `image` (the media fills the band and the text sits on a
 * solid panel over it, so it stays readable on any photo; on mobile the
 * picture is above the text). `align="center"` centres a stacked hero.
 * `tone` sets the band: Paper (default), Well, or `primary`, the primary wash.
 *
 * Actions take `{ label, href }` (links styled as buttons); for anything else
 * fill the `actions` slot. Slots: `eyebrow`, `title`, `description`,
 * `actions`, `footnote`, `media`, and the default slot under the actions
 * (e.g. a search form or quick links).
 *
 * @example
 * <Hero
 *   eyebrow="New"
 *   title="Pay your government bills in one place"
 *   description="Settle fees, fines and assessments from 30 agencies with one MyDigital ID."
 *   primaryAction={{ label: "Start a payment", href: "/pay" }}
 *   secondaryAction={{ label: "How it works", href: "#how" }}
 * >
 *   <img slot="media" src="/hero.png" alt="" />
 * </Hero>
 */
interface HeroAction {
  label: string;
  href: string;
}

type Props = Omit<HTMLAttributes<"section">, "class" | "title"> & {
  /** Short label above the title, rendered as a primary Tag. */
  eyebrow?: string;
  /** The page title, rendered as the only h1. */
  title?: string;
  description?: string;
  primaryAction?: HeroAction;
  secondaryAction?: HeroAction;
  /** Short line under the actions, e.g. a reassurance. */
  footnote?: string;
  /** Defaults to `"split"` with media, `"stacked"` without. */
  layout?: "stacked" | "split" | "image";
  /** Text alignment of a stacked hero. Defaults to `"start"`. */
  align?: "start" | "center";
  /** Side of the media in a split hero on desktop. Defaults to `"right"`. */
  mediaPosition?: "left" | "right";
  /** Band: Paper (default), Well, or the primary wash. On `image`, the panel's colour. */
  tone?: "paper" | "well" | "primary";
  /** `id` for the h1. Generated when unset. */
  titleId?: string;
  class?: string;
};

const slots = Astro.slots;
const hasMedia = slots.has("media");

const {
  eyebrow,
  title,
  description,
  primaryAction,
  secondaryAction,
  footnote,
  layout: layoutProp,
  align: alignProp = "start",
  mediaPosition = "right",
  tone = "paper",
  titleId = uniqueId("hero"),
  class: className,
  ...props
} = Astro.props;

// Without media a split or image hero has nothing to show beside the text
const layout = hasMedia ? (layoutProp ?? "split") : "stacked";
const align = layout === "stacked" ? alignProp : "start";
const hasActions = Boolean(primaryAction || secondaryAction) || slots.has("actions");
---

<section
  aria-labelledby={titleId}
  class={clx(band_cva({ tone, layout }), className)}
  {...props}
>
  <div class={container_cva({ layout })}>
    <div class={content_cva({ layout, align, mediaPosition, tone })}>
      <slot name="eyebrow">
        {eyebrow && <Tag variant="primary" size="medium">{eyebrow}</Tag>}
      </slot>
      <div class="flex flex-col gap-4">
        <h1
          id={titleId}
          class="text-txt-black-900 text-heading-sm md:text-heading-md lg:text-heading-lg font-semibold tracking-[-0.02em] text-balance"
        >
          <slot name="title">{title}</slot>
        </h1>
        {
          (description || slots.has("description")) && (
            <p
              class={clx(
                "text-txt-black-700 text-body-lg md:text-body-xl max-w-[60ch]",
                align === "center" && "mx-auto",
              )}
            >
              <slot name="description">{description}</slot>
            </p>
          )
        }
      </div>
      {
        hasActions && (
          <div class={actions_cva({ align })}>
            <slot name="actions">
              {primaryAction && (
                <Button variant="primary-fill" size="large" href={primaryAction.href}>
                  {primaryAction.label}
                </Button>
              )}
              {secondaryAction && (
                <Button
                  variant="default-outline"
                  size="large"
                  href={secondaryAction.href}
                  class={secondary_action_cva({ tone, layout })}
                >
                  {secondaryAction.label}
                </Button>
              )}
            </slot>
          </div>
        )
      }
      {
        (footnote || slots.has("footnote")) && (
          <p class="text-txt-black-700 text-body-md">
            <slot name="footnote">{footnote}</slot>
          </p>
        )
      }
      <slot />
    </div>
    {
      hasMedia && (
        <div class={media_cva({ layout })}>
          <slot name="media" />
        </div>
      )
    }
  </div>
</section>

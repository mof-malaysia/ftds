---
import { href } from "~/lib/url";
import { t } from "~/lib/i18n";
---

<dialog class="doc-search" data-search data-index={href("/search.json")} aria-label={t("search")}>
  <form method="dialog" class="doc-search-field">
    <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><circle cx="9" cy="9" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="m13.5 13.5 3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
    <input type="search" placeholder={t("searchPlaceholder")} aria-label={t("searchPlaceholder")} autocomplete="off" spellcheck="false" />
  </form>
  <ul class="doc-search-results" role="listbox" aria-label={t("search")}></ul>
  <p class="doc-search-empty" hidden>{t("noResults")}</p>
</dialog>

<script>
  import "~/scripts/search";
</script>

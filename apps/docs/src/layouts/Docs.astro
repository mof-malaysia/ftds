---
import Base from "./Base.astro";
import Rail from "~/components/Rail.astro";
import Logo from "~/components/Logo.astro";
import SearchButton from "~/components/SearchButton.astro";
import SearchDialog from "~/components/SearchDialog.astro";
import { t } from "~/lib/i18n";

interface Props {
  title: string;
  description?: string;
  /** Rail item for this page, e.g. `components/button`. */
  current: string;
}

const { title, description, current } = Astro.props;
---

<Base title={title} description={description}>
  <a href="#content" class="doc-skip">{t("skip")}</a>

  <header class="doc-mobile-bar">
    <Logo />
    <div>
      <SearchButton />
      <button type="button" class="doc-icon-button" popovertarget="doc-menu" aria-label={t("menu")}>
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M3.5 6h13M3.5 10h13M3.5 14h13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
      </button>
    </div>
  </header>

  <div id="doc-menu" popover class="doc-menu">
    <button type="button" class="doc-icon-button doc-menu-close" popovertarget="doc-menu" popovertargetaction="hide" aria-label={t("closeMenu")}>
      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
    </button>
    <Rail current={current} idPrefix="menu" />
  </div>

  <div class="doc-shell">
    <aside class="doc-rail" data-rail>
      <Rail current={current} />
    </aside>
    <main id="content" tabindex="-1" class="doc-main">
      <slot />
    </main>
  </div>

  <SearchDialog />

  <script>
    import "~/scripts/copy";
    import "~/scripts/conditions";
  </script>
</Base>

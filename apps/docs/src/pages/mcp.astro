---
import Reading from "~/layouts/Reading.astro";
import CopyButton from "~/components/CopyButton.astro";
import CommandBlock from "~/components/CommandBlock.astro";
import { href } from "~/lib/url";

/**
 * How coding agents and assistants read FTDS. Menu names follow each product's
 * help pages as of October 2026.
 */
const MCP_URL = import.meta.env.PUBLIC_FTDS_MCP_URL || "https://ftds-mcp.irfan-ismail96.workers.dev/mcp";

const PROMPT = "Mock up an officer dashboard for reviewing grant applications, with status filters and a table.";

const apps = [
  {
    name: "Claude",
    steps: [
      "Open <b>Customize → Connectors</b>.",
      "Click <b>+ Add</b>, then <b>Add custom connector</b>.",
      "Name it <b>FTDS</b>, paste the URL and click <b>Continue</b>.",
      "Choose <b>No sign in</b>, then click <b>Add</b>.",
      "In a chat, click <b>+ → Connectors</b> and turn on <b>FTDS</b>.",
    ],
    note: "Works on every plan. Free allows one custom connector, and on Team and Enterprise, an owner adds it under Organization settings → Connectors first.",
  },
  {
    name: "ChatGPT",
    steps: [
      "Open <b>Settings → Apps → Advanced settings</b> and turn on <b>Developer mode</b>.",
      "Click <b>Create app</b>.",
      "Name it <b>FTDS</b>, paste the URL and set Authentication to <b>No authentication</b>.",
      "Confirm you trust the app, then click <b>Create</b>.",
      "In a chat, click <b>+ → Developer mode</b> and turn on <b>FTDS</b>.",
    ],
    note: "Needs Plus, Pro, Business, Enterprise or Edu, on chatgpt.com. On Business and Enterprise, an admin may need to allow developer mode first.",
  },
];
---

<Reading
  title="AI assistants"
  description="Try a screen idea in Claude or ChatGPT using real FTDS components, and give your coding agents the same documentation your team reads."
  current="mcp"
  toc={[
    { id: "text", label: "Plain-text docs" },
    { id: "mcp", label: "MCP server" },
    { id: "ask", label: "Ask for a screen" },
  ]}
>
  <h2 id="text">Plain-text docs</h2>
  <ul>
    <li><a href={href("/llms.txt")}>llms.txt</a> is the index and the rules.</li>
    <li><a href={href("/llms-full.txt")}>llms-full.txt</a> is every page in one file.</li>
    <li>Each component has its own Markdown page, for example <a href={href("/components/button.md")}>button.md</a>, with its props read from the code.</li>
  </ul>

  <h2 id="mcp">MCP server</h2>
  <p>Connect your assistant with this URL. It takes a few minutes, and no sign-in is needed.</p>
  <div class="code-block doc-command">
    <pre class="break-all whitespace-pre-wrap">{MCP_URL}</pre>
    <CopyButton class="absolute top-1/2 right-2 -translate-y-1/2" label="Copy URL" />
  </div>
  {apps.map((app) => (
    <>
      <h3>{app.name}</h3>
      <ol>
        {app.steps.map((step) => <li set:html={step} />)}
      </ol>
      <p>{app.note}</p>
    </>
  ))}

  <h2 id="ask">Ask for a screen</h2>
  <p>A quick way to explore an idea with your team before any code is written. Try this one:</p>
  <CommandBlock command={PROMPT} label="Copy prompt" />
  <ul>
    <li>The screen appears in the chat.</li>
    <li>Ask for changes in plain words.</li>
    <li>To share it, use the link button above the screen.</li>
  </ul>
</Reading>
